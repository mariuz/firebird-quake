    "test:registered": "node scripts/registered-test.mjs",
    "test:infight": "node scripts/infight-test.mjs",
    "test:skill": "node scripts/skill-test.mjs",
    "test:save": "node scripts/save-test.mjs",
    "test:demo": "node scripts/demo-test.mjs",
    "test:dm": "node scripts/dm-test.mjs",
    "test:hazard": "node scripts/hazard-test.mjs",
    "test:fire": "node scripts/fire-test.mjs",
    "test:bsp2": "node scripts/bsp2-test.mjs",
    "test:water": "node scripts/water-test.mjs",
    "test:lq": "node scripts/lq-test.mjs",
    "test:levels": "node scripts/levels-test.mjs",
