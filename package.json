{
  "name": "firebird-quake",
  "version": "0.1.0",
  "private": true,
  "description": "Quake simulated and rendered inside Firebird SQL, running in the browser via Firebird WASM",
  "type": "module",
  "scripts": {
    "fetch-pak": "node scripts/fetch-pak.mjs",
    "fetch-librequake": "node scripts/fetch-pak.mjs --librequake",
    "gen-frame-layouts": "node scripts/gen-frame-layouts.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/build.mjs --serve",
    "test": "node scripts/sql-smoke.mjs",
    "test:boss": "node scripts/boss-test.mjs",
    "test:registered": "node scripts/registered-test.mjs",
    "test:e1m8": "node scripts/e1m8-test.mjs",
    "test:e1m5": "node scripts/e1m5-test.mjs",
    "test:e1m2": "node scripts/e1m2-test.mjs",
    "test:e1m3": "node scripts/e1m3-test.mjs",
    "test:e1m4": "node scripts/e1m4-test.mjs",
    "test:e1m6": "node scripts/e1m6-test.mjs",
    "test:qcvm": "node scripts/qcvm-test.mjs",
    "test:qcplay": "node scripts/qcvm-play-test.mjs",
    "test:qctic": "node scripts/qcvm-tic-test.mjs",
    "test:qcai": "node scripts/qcvm-ai-test.mjs",
    "test:qcjit": "node scripts/qcjit-test.mjs",
    "test:qclq": "node scripts/qcvm-lq-test.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:qc": "node scripts/qcvm-bench.mjs",
    "screenshots": "node scripts/screenshot.mjs e1m1",
    "check": "node scripts/sql-check.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "firebird-wasm": "^0.3.0"
  },
  "devDependencies": {
    "esbuild-wasm": "^0.25.0"
  },
  "engines": {
    "node": ">=20"
  }
}
